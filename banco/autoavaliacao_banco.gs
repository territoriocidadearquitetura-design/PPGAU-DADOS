const PAGINA = "<!doctype html>\n<html lang=\"pt-BR\"><head><base target=\"_top\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>\n:root{--bg:#f4f6f8;--sf:#fff;--sf2:#eef2f6;--ink:#14202b;--ink2:#485664;--mut:#6f7c89;--line:#d9e0e7;--ac:#02205f;--acs:#e6ebf5;--gold:#febf01;--ok:#0c7a0c;--err:#b42d2d;--warn:#fff4dc}\n*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 \"Segoe UI\",system-ui,-apple-system,Roboto,sans-serif}\nheader{background:var(--ac);color:#fff;padding:18px 16px}header .w{max-width:820px;margin:0 auto}header small{display:block;color:#c9d3e6;font-size:13px}header b{font-size:19px}\n.w{max-width:820px;margin:0 auto;padding:0 16px}main{padding:22px 0 40px}\nh2{font-size:23px;margin:0 0 8px}h3{margin:0 0 6px;font-size:18px}p{margin:0 0 12px}.mut{color:var(--mut)}.small{font-size:14px}\n.card{background:var(--sf);border:1px solid var(--line);border-radius:12px;padding:18px;margin:0 0 14px}\n.pubs{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}\n.pub{text-align:left;font:inherit;color:inherit;background:var(--sf);border:1px solid var(--line);border-radius:12px;padding:16px;cursor:pointer}\n.pub:hover,.pub:focus{border-color:var(--ac);outline:none;box-shadow:0 0 0 3px var(--acs)}\n.pub .cod{font-size:12px;font-weight:700;color:var(--ac);text-transform:uppercase;letter-spacing:.04em}.pub p{font-size:14px;color:var(--ink2);margin:4px 0 0}\n.btn{font:600 16px inherit;font-family:inherit;border:0;border-radius:10px;padding:12px 20px;background:var(--ac);color:#fff;cursor:pointer}\n.btn.sec{background:var(--sf);color:var(--ac);border:1px solid var(--ac)}.btn:disabled{opacity:.5;cursor:default}\n.nav{display:flex;gap:10px;justify-content:space-between;margin-top:18px;flex-wrap:wrap}\nlabel.f{display:block;font-weight:600;margin:12px 0 4px}input[type=text],input[type=email],input[type=url],input[type=password],input[type=date],textarea,select{width:100%;font:inherit;padding:10px 12px;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink)}\ntextarea{min-height:96px;resize:vertical}\n.q{background:var(--sf);border:1px solid var(--line);border-radius:12px;padding:16px;margin:0 0 12px}.q .t{font-weight:600;margin-bottom:8px}.q .t span{color:var(--ac);margin-right:4px}.q .aj{font-size:14px;color:var(--mut);margin:-4px 0 8px}\n.op{display:flex;gap:10px;align-items:flex-start;padding:7px 8px;border-radius:8px;cursor:pointer}.op:hover{background:var(--sf2)}.op input{margin-top:4px;width:18px;height:18px;flex:none}\n.op input[type=text]{width:auto;flex:1;margin:0;height:auto;padding:6px 8px}\n.mx{display:grid;gap:8px}.mx div{display:grid;grid-template-columns:1fr minmax(180px,40%);gap:10px;align-items:center;padding:6px 0;border-top:1px solid var(--sf2)}\n.prog{height:8px;background:var(--sf2);border-radius:99px;overflow:hidden;margin:6px 0 16px}.prog span{display:block;height:100%;background:var(--gold)}\n.aviso{background:var(--warn);border-radius:10px;padding:12px 14px;font-size:15px;margin:0 0 14px}\n.err{color:var(--err);font-weight:600}.okm{color:var(--ok);font-weight:600}\n.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:10px;margin-bottom:14px}\n.tile{font:inherit;text-align:left;background:var(--sf);border:1px solid var(--line);border-radius:12px;padding:12px 14px;cursor:pointer;color:inherit}.tile.on{border-color:var(--ac);box-shadow:0 0 0 3px var(--acs)}\n.tile b{display:block;font-size:26px;color:var(--ac)}.tile b small{font-size:15px;color:var(--mut);font-weight:400}.bar{height:6px;background:var(--sf2);border-radius:99px;margin-top:6px}.bar span{display:block;height:100%;background:var(--ac);border-radius:99px}\nul.pl{list-style:none;margin:0;padding:0}ul.pl li{display:flex;gap:10px;padding:8px 0;border-top:1px solid var(--sf2)}ul.pl li .i{width:22px;flex:none;font-weight:700}ul.pl li.ok .i{color:var(--ok)}ul.pl li.pend{color:var(--mut)}ul.pl small{display:block;color:var(--mut)}\ntable{border-collapse:collapse;width:100%;font-size:14px}th,td{text-align:left;padding:7px 8px;border-bottom:1px solid var(--line);vertical-align:top}th{background:var(--sf2)}.tw{overflow-x:auto}\nfooter{border-top:1px solid var(--line);padding:16px 0 30px;font-size:13px;color:var(--mut)}\n@media(max-width:560px){.mx div{grid-template-columns:1fr}h2{font-size:21px}.btn{flex:1}}\n</style></head><body>\n<header><div class=\"w\"><small>PPGAU/UNIVAG · Programa de Pós-Graduação em Arquitetura e Urbanismo</small><b id=\"titulo\">Autoavaliação 2026</b></div></header>\n<main><div class=\"w\" id=\"v\"></div></main>\n<footer><div class=\"w\">© 2026 PPGAU/UNIVAG, UNIVAG Centro Universitário · Av. Dom Orlando Chaves, 2.655, Cristo Rei, Várzea Grande, MT · As informações coletadas pertencem ao programa e são usadas apenas para a autoavaliação.<br>Coordenação: Profa. Dra. Jeane Aparecida Rombi de Godoy · Coordenação adjunta: Prof. Dr. Angelo Palmisano · Desenvolvimento e organização: Profa. Dra. Sandra Medina Benini</div></footer>\n<script>\n/*BOOT*/\nvar D = BOOT.dados, V = document.getElementById('v');\nfunction esc(t){return String(t==null?'':t).replace(/[&<>\"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]})}\nfunction pubById(id){return D.filter(function(p){return p.id===id})[0]}\nfunction guarda(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}\nfunction le(k){try{return JSON.parse(localStorage.getItem(k))}catch(e){return null}}\nfunction apaga(k){try{localStorage.removeItem(k)}catch(e){}}\nfunction topo(){window.scrollTo(0,0)}\nvar st={etapa:'escolha',pub:null,passo:0,r:{},id:{}};\n\nif(BOOT.modo==='admin') adminInicio(); else { if(BOOT.q&&pubById(BOOT.q)){st.pub=BOOT.q;st.etapa='apres'} render(); }\n\nfunction render(){\n  var p=st.pub&&pubById(st.pub);\n  if(st.etapa==='escolha'||!p) return escolha();\n  if(st.etapa==='apres') return apres(p);\n  if(st.etapa==='ident') return ident(p);\n  if(st.etapa==='fim') return fim(p);\n  secao(p);\n}\nfunction escolha(){\n  V.innerHTML='<div class=\"aviso\" style=\"background:#fdecec;border-left:5px solid #c62828\"><b>Prazo final de preenchimento:</b> <b style=\"color:#c62828\">15 de novembro de 2026</b></div><h2>Qual é o seu vínculo com o programa?</h2><p class=\"mut\">Escolha o questionário correspondente. Você informa nome e e-mail apenas para registrar a participação; as respostas são gravadas em outra tabela, sem nome e sem vínculo com essa lista.</p><div class=\"pubs\">'+\n  D.map(function(p){var n=p.secoes.reduce(function(a,s){return a+s.qs.length},0);return '<button class=\"pub\" data-p=\"'+p.id+'\"><span class=\"cod\">Questionário '+p.id+'</span><h3>'+esc(p.nome)+'</h3><p>'+esc(p.desc)+'</p><p class=\"small mut\">'+n+' perguntas</p></button>'}).join('')+'</div>';\n  V.querySelectorAll('.pub').forEach(function(b){b.onclick=function(){st.pub=b.dataset.p;st.etapa='apres';render();topo()}});\n}\nfunction apres(p){\n  V.innerHTML='<div class=\"card\"><div class=\"small mut\">Questionário '+p.id+'</div><h2>'+esc(p.nome)+'</h2>'+\n  '<p>O PPGAU/UNIVAG realiza esta autoavaliação para analisar a qualidade da formação, as condições de pesquisa e o funcionamento acadêmico e administrativo do programa. Os resultados subsidiarão ações de melhoria, o planejamento estratégico e a análise das condições para um doutorado em Arquitetura e Urbanismo.</p>'+\n  '<p>A participação é voluntária e as respostas não interferem em notas, bolsas, orientações ou vínculos. É possível deixar perguntas sem resposta.</p>'+\n  (p.identificado?'<div class=\"aviso\">'+esc(p.aviso||'Instrumento identificado.')+'</div>':'<div class=\"aviso\"><b>Como funciona o anonimato.</b> Na próxima tela você informa nome, e-mail e Lattes. Esses dados vão para a lista de participação, que a coordenação usa só para saber quem já respondeu. As respostas vão para outra tabela, sem nome, sem e-mail, sem horário e em ordem embaralhada. Ninguém, nem a coordenação, consegue saber o que cada pessoa respondeu. Nos campos abertos, evite mencionar pessoas ou situações que permitam identificação.</div>')+\n  (p.tempo?'<p class=\"small mut\">'+esc(p.tempo)+'</p>':'')+\n  '<div class=\"nav\"><button class=\"btn sec\" id=\"volta\">Voltar</button><button class=\"btn\" id=\"seg\">Aceito participar</button></div></div>';\n  document.getElementById('volta').onclick=function(){st.etapa='escolha';st.pub=null;render()};\n  document.getElementById('seg').onclick=function(){st.etapa='ident';render();topo()};\n}\nfunction ident(p){\n  var i=le('ppgau-id')||{};\n  V.innerHTML='<div class=\"card\"><h2>Identificação para a lista de participação</h2><p class=\"mut small\">'+(p.identificado?'':'Estes dados não ficam junto das respostas. ')+'Servem para a coordenação saber quem já participou e evitar envios repetidos.</p>'+\n  '<label class=\"f\" for=\"nm\">Nome completo</label><input type=\"text\" id=\"nm\" autocomplete=\"name\" value=\"'+esc(i.nome||'')+'\">'+\n  '<label class=\"f\" for=\"em\">E-mail</label><input type=\"email\" id=\"em\" autocomplete=\"email\" value=\"'+esc(i.email||'')+'\">'+\n  '<label class=\"f\" for=\"la\">Link do currículo Lattes <span class=\"mut\">(opcional)</span></label><input type=\"url\" id=\"la\" placeholder=\"http://lattes.cnpq.br/0000000000000000\" value=\"'+esc(i.lattes||'')+'\">'+\n  '<p id=\"msg\" class=\"err\" style=\"margin-top:10px\"></p><div class=\"nav\"><button class=\"btn sec\" id=\"volta\">Voltar</button><button class=\"btn\" id=\"seg\">Continuar</button></div></div>';\n  document.getElementById('volta').onclick=function(){st.etapa='apres';render()};\n  document.getElementById('seg').onclick=function(){\n    var nome=document.getElementById('nm').value.trim(),email=document.getElementById('em').value.trim().toLowerCase(),lattes=document.getElementById('la').value.trim(),m=document.getElementById('msg');\n    if(nome.split(/\\s+/).length<2){m.textContent='Informe o nome completo.';return}\n    if(!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)){m.textContent='Informe um e-mail válido.';return}\n    var b=this;b.disabled=true;m.className='mut';m.textContent='Verificando...';\n    google.script.run.withSuccessHandler(function(res){b.disabled=false;\n      if(res&&res.ja){m.className='err';m.textContent='Este e-mail já registrou participação neste questionário. Obrigado!';return}\n      st.id={nome:nome,email:email,lattes:lattes};guarda('ppgau-id',st.id);\n      st.r=le('ppgau-r-'+p.id)||{};st.passo=0;st.etapa='secao';render();topo();\n    }).withFailureHandler(function(e){b.disabled=false;m.className='err';m.textContent='Não foi possível verificar agora. Tente de novo. ('+e.message+')'}).verificar(email,p.id);\n  };\n}\nfunction visiveis(p){return p.secoes.filter(function(s){return !(s.pula&&st.r[s.pula.k]===s.pula.se)})}\nfunction secao(p){\n  var vs=visiveis(p);if(st.passo>=vs.length)st.passo=vs.length-1;var s=vs[st.passo],ult=st.passo===vs.length-1;\n  V.innerHTML='<div class=\"small mut\">Questionário '+p.id+' · '+esc(p.nome)+' · parte '+(st.passo+1)+' de '+vs.length+'</div><div class=\"prog\"><span style=\"width:'+Math.round(100*(st.passo+1)/vs.length)+'%\"></span></div>'+\n  '<h2>'+esc(s.titulo)+'</h2>'+(s.nota?'<p class=\"mut\">'+esc(s.nota)+'</p>':'')+s.qs.map(questao).join('')+\n  '<p id=\"msg\" class=\"err\"></p><div class=\"nav\"><button class=\"btn sec\" id=\"ant\">'+(st.passo?'Anterior':'Voltar')+'</button><button class=\"btn\" id=\"prox\">'+(ult?'Enviar respostas':'Próxima parte')+'</button></div>';\n  ligar(s);\n  document.getElementById('ant').onclick=function(){if(st.passo){st.passo--;render()}else{st.etapa='ident';render()}topo()};\n  document.getElementById('prox').onclick=function(){\n    if(!ult){st.passo++;render();topo();return}\n    if(!confirm('Enviar as respostas? Depois do envio não é possível alterar.'))return;\n    var b=this,m=document.getElementById('msg');b.disabled=true;m.className='mut';m.textContent='Enviando...';\n    var r={};visiveis(p).forEach(function(s){s.qs.forEach(function(q){if(st.r[q.k]!=null)r[q.k]=st.r[q.k]})});\n    google.script.run.withSuccessHandler(function(res){\n      if(res&&res.ja){m.className='err';m.textContent='Este e-mail já registrou participação neste questionário.';b.disabled=false;return}\n      apaga('ppgau-r-'+p.id);st.etapa='fim';render();topo();\n    }).withFailureHandler(function(e){b.disabled=false;m.className='err';m.textContent='O envio falhou. Suas respostas continuam aqui; tente de novo. ('+e.message+')'}).enviar({pub:p.id,nome:st.id.nome,email:st.id.email,lattes:st.id.lattes,r:r});\n  };\n}\nfunction questao(q){\n  var v=st.r[q.k],h='<div class=\"q\" data-k=\"'+q.k+'\"><div class=\"t\"><span>'+esc(q.n)+'.</span>'+esc(q.t)+'</div>'+(q.ajuda?'<div class=\"aj\">'+esc(q.ajuda)+'</div>':'')+(q.tipo==='multi'&&q.max?'<div class=\"aj\">Marque até '+q.max+'.</div>':'');\n  var nm='q_'+q.k.replace('.','_');\n  if(q.tipo==='scale'||q.tipo==='single'){\n    var outroV=v&&q.opts.indexOf(v)<0?v.replace(/^Outro: /,''):'';\n    h+=q.opts.map(function(o){return '<label class=\"op\"><input type=\"radio\" name=\"'+nm+'\" value=\"'+esc(o)+'\"'+(v===o?' checked':'')+'><span>'+esc(o)+'</span></label>'}).join('');\n    if(q.outro)h+='<label class=\"op\"><input type=\"radio\" name=\"'+nm+'\" value=\"__outro\"'+(outroV?' checked':'')+'><input type=\"text\" class=\"ot\" placeholder=\"Outro\" value=\"'+esc(outroV)+'\"></label>';\n  } else if(q.tipo==='multi'){\n    var arr=v||[],ot=arr.filter(function(x){return q.opts.indexOf(x)<0})[0];ot=ot?ot.replace(/^Outro: /,''):'';\n    h+=q.opts.map(function(o){return '<label class=\"op\"><input type=\"checkbox\" value=\"'+esc(o)+'\"'+(arr.indexOf(o)>=0?' checked':'')+'><span>'+esc(o)+'</span></label>'}).join('');\n    if(q.outro)h+='<label class=\"op\"><input type=\"checkbox\" value=\"__outro\"'+(ot?' checked':'')+'><input type=\"text\" class=\"ot\" placeholder=\"Outro\" value=\"'+esc(ot)+'\"></label>';\n  } else if(q.tipo==='matrix'){\n    var mv=v||{};h+='<div class=\"mx\">'+q.linhas.map(function(l,i){return '<div><span>'+esc(l)+'</span><select data-i=\"'+i+'\"><option value=\"\">Selecione</option>'+q.opts.map(function(o){return '<option'+(mv[i]===o?' selected':'')+'>'+esc(o)+'</option>'}).join('')+'</select></div>'}).join('')+'</div>';\n  } else if(q.tipo==='open'){h+='<textarea>'+esc(v||'')+'</textarea>'}\n  else if(q.tipo==='date'){h+='<input type=\"date\" value=\"'+esc(v||'')+'\">'}\n  else h+='<input type=\"text\" value=\"'+esc(v||'')+'\">';\n  return h+'</div>';\n}\nfunction ligar(s){\n  var p=pubById(st.pub);\n  s.qs.forEach(function(q){\n    var el=V.querySelector('.q[data-k=\"'+q.k+'\"]');\n    function salva(){\n      if(q.tipo==='scale'||q.tipo==='single'){var c=el.querySelector('input[type=radio]:checked');if(!c)delete st.r[q.k];else if(c.value==='__outro'){var t=el.querySelector('.ot').value.trim();if(t)st.r[q.k]='Outro: '+t;else delete st.r[q.k]}else st.r[q.k]=c.value}\n      else if(q.tipo==='multi'){var a=[];el.querySelectorAll('input[type=checkbox]:checked').forEach(function(c){if(c.value==='__outro'){var t=el.querySelector('.ot').value.trim();if(t)a.push('Outro: '+t)}else a.push(c.value)});if(a.length)st.r[q.k]=a;else delete st.r[q.k]}\n      else if(q.tipo==='matrix'){var o={};el.querySelectorAll('select').forEach(function(x){if(x.value)o[x.dataset.i]=x.value});if(Object.keys(o).length)st.r[q.k]=o;else delete st.r[q.k]}\n      else{var t2=el.querySelector('textarea,input').value.trim();if(t2)st.r[q.k]=t2;else delete st.r[q.k]}\n      guarda('ppgau-r-'+p.id,st.r);\n    }\n    el.addEventListener('change',function(ev){\n      if(q.tipo==='multi'&&q.max&&ev.target.type==='checkbox'&&ev.target.checked&&el.querySelectorAll('input[type=checkbox]:checked').length>q.max){ev.target.checked=false;alert('Marque no máximo '+q.max+' opções.')}\n      if(ev.target.classList.contains('ot')&&ev.target.value.trim()){var box=ev.target.parentNode.querySelector('input[type=radio],input[type=checkbox]');if(box&&!box.checked){box.checked=true}}\n      salva();\n    });\n    el.addEventListener('input',function(ev){if(ev.target.tagName==='TEXTAREA'||ev.target.type==='text'||ev.target.type==='date')salva()});\n  });\n}\nfunction fim(p){\n  V.innerHTML='<div class=\"card\"><h2>Resposta registrada</h2><p>Obrigado por contribuir com a autoavaliação do PPGAU/UNIVAG. Sua participação foi anotada e suas respostas foram gravadas sem identificação, para análise agregada.</p><div class=\"nav\"><button class=\"btn sec\" id=\"volta\">Voltar ao início</button></div></div>';\n  document.getElementById('volta').onclick=function(){st.etapa='escolha';st.pub=null;st.r={};render()};\n}\n\n// ---------- painel administrativo ----------\nvar AD={dados:null,grupo:'B'};\nfunction adminInicio(){\n  document.getElementById('titulo').textContent='Painel da coordenação · Autoavaliação 2026';\n  V.innerHTML='<div class=\"card\"><p class=\"mut\">Carregando...</p></div>';\n  google.script.run.withSuccessHandler(function(r){if(r&&r.ok){AD.dados=r;adminRender()}else adminLogin('')}).withFailureHandler(function(){adminLogin('')}).painel('');\n}\nfunction adminLogin(erro){\n  V.innerHTML='<div class=\"card\" style=\"max-width:420px\"><h2>Acesso da coordenação</h2><p class=\"mut small\">Mostra apenas quem participou (nome, e-mail e Lattes). As respostas ficam em outra base, sem identificação.</p><label class=\"f\" for=\"pw\">Senha do painel</label><input type=\"password\" id=\"pw\"><p class=\"err\">'+esc(erro)+'</p><div class=\"nav\"><button class=\"btn\" id=\"ent\">Entrar</button></div></div>';\n  var go=function(){var b=document.getElementById('ent');b.disabled=true;google.script.run.withSuccessHandler(function(r){if(r&&r.ok){AD.dados=r;AD.senha=document.getElementById('pw').value;adminRender()}else adminLogin('Senha incorreta.')}).withFailureHandler(function(e){adminLogin(e.message)}).painel(document.getElementById('pw').value)};\n  document.getElementById('ent').onclick=go;document.getElementById('pw').onkeydown=function(e){if(e.key==='Enter')go()};\n}\nfunction nz(t){return String(t||'').normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase().replace(/[^a-z ]/g,'').replace(/\\s+/g,' ').trim()}\nfunction adminRender(){\n  var d=AD.dados,lista=d.part.slice().sort(function(a,b){return a.nome.localeCompare(b.nome,'pt-BR')});\n  function achou(nome,id){var a=nz(nome);return lista.filter(function(c){var b=nz(c.nome);return c.pub===id&&(a===b||(a.split(' ')[0]===b.split(' ')[0]&&a.split(' ').pop()===b.split(' ').pop()))})[0]}\n  var G=[['B','Docentes'],['A','Discentes em curso'],['P','Pós-doutorandos'],['C','Egressos']].map(function(g){var l=(d.esperados[g[0]]||[]).map(function(n){return {n:n,c:achou(n,g[0])}});return {id:g[0],t:g[1],l:l,ok:l.filter(function(x){return x.c}).length}});\n  var usados={};G.forEach(function(g){g.l.forEach(function(x){if(x.c)usados[x.c.email+'|'+x.c.pub]=1})});\n  var outros=lista.filter(function(c){return !usados[c.email+'|'+c.pub]});\n  var g=G.filter(function(x){return x.id===AD.grupo})[0]||G[0];\n  var nomePub=function(id){var p=pubById(id);return p?p.nome:id};\n  V.innerHTML='<h2>Participação na autoavaliação</h2><p class=\"mut\">Quem já respondeu, comparado com a lista de pessoas do programa. Este painel mostra só nome, e-mail e Lattes. As respostas ficam em outra tabela, sem identificação e em ordem embaralhada.</p>'+\n  '<div class=\"tiles\">'+G.map(function(x){var pc=x.l.length?Math.round(100*x.ok/x.l.length):0;return '<button class=\"tile'+(x.id===g.id?' on':'')+'\" data-g=\"'+x.id+'\"><span class=\"small mut\">'+esc(x.t)+'</span><b>'+x.ok+'<small> de '+x.l.length+'</small></b><div class=\"bar\"><span style=\"width:'+pc+'%\"></span></div></button>'}).join('')+\n  '<div class=\"tile\" style=\"cursor:default\"><span class=\"small mut\">Respostas gravadas</span><b>'+d.total+'</b><span class=\"small mut\">'+D.map(function(p){return p.id+': '+(d.cont[p.id]||0)}).join(' · ')+'</span></div></div>'+\n  '<div class=\"card\"><h3>'+esc(g.t)+': '+g.ok+' participaram, '+(g.l.length-g.ok)+' pendentes</h3><ul class=\"pl\">'+g.l.sort(function(a,b){return (!!a.c-!!b.c)||a.n.localeCompare(b.n,'pt-BR')}).map(function(x){return '<li class=\"'+(x.c?'ok':'pend')+'\"><span class=\"i\">'+(x.c?'✓':'…')+'</span><span><strong>'+esc(x.n)+'</strong><small>'+(x.c?esc(x.c.email)+' · '+esc(x.c.data):'ainda não respondeu')+'</small></span></li>'}).join('')+'</ul><p class=\"small mut\" style=\"margin-top:8px\">Comparação pelo nome informado. Quem escreveu o nome de outro jeito aparece em \"Outros registros\".</p></div>'+\n  (outros.length?'<div class=\"card\"><h3>Outros registros ('+outros.length+')</h3><p class=\"small mut\">Equipe técnica, gestão ou nomes escritos de forma diferente da lista.</p><ul class=\"pl\">'+outros.map(function(c){return '<li class=\"ok\"><span class=\"i\">✓</span><span><strong>'+esc(c.nome)+'</strong><small>'+esc(c.email)+' · '+esc(nomePub(c.pub))+' · '+esc(c.data)+'</small></span></li>'}).join('')+'</ul></div>':'')+\n  '<div class=\"card\"><h3>Lista completa ('+lista.length+')</h3><div class=\"tw\"><table><thead><tr><th>Nome</th><th>E-mail</th><th>Lattes</th><th>Questionário</th><th>Data</th></tr></thead><tbody>'+lista.map(function(c){return '<tr><td>'+esc(c.nome)+'</td><td>'+esc(c.email)+'</td><td>'+(/^https?:\\/\\//.test(c.lattes)?'<a href=\"'+esc(c.lattes)+'\" target=\"_blank\" rel=\"noopener\">abrir</a>':esc(c.lattes))+'</td><td>'+esc(c.pub)+'</td><td>'+esc(c.data)+'</td></tr>'}).join('')+'</tbody></table></div>'+\n  '<div class=\"nav\" style=\"justify-content:flex-start\"><button class=\"btn sec\" id=\"csv\">Baixar lista (CSV)</button><button class=\"btn sec\" id=\"atu\">Atualizar</button>'+(d.planilha?'<a class=\"btn sec\" style=\"text-decoration:none\" href=\"'+esc(d.planilha)+'\" target=\"_blank\" rel=\"noopener\">Abrir planilha</a>':'')+'</div></div>';\n  V.querySelectorAll('[data-g]').forEach(function(b){b.onclick=function(){AD.grupo=b.dataset.g;adminRender()}});\n  document.getElementById('atu').onclick=function(){google.script.run.withSuccessHandler(function(r){if(r&&r.ok){AD.dados=r;adminRender()}}).painel(AD.senha||'')};\n  document.getElementById('csv').onclick=function(){\n    var q=function(t){return '\"'+String(t||'').replace(/\"/g,'\"\"')+'\"'};\n    var csv='﻿Nome;E-mail;Lattes;Questionário;Data\\n'+lista.map(function(c){return [c.nome,c.email,c.lattes,nomePub(c.pub),c.data].map(q).join(';')}).join('\\n');\n    var a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download='participacao_autoavaliacao_2026.csv';document.body.appendChild(a);a.click();a.remove();\n  };\n}\n</script></body></html>\n";
const PROPS = PropertiesService.getScriptProperties();
const TZ = 'America/Cuiaba';

function instalar() {
  const ja = PROPS.getProperty('PLANILHA');
  if (ja) { Logger.log('Já instalado. Planilha: ' + SpreadsheetApp.openById(ja).getUrl()); return; }
  const ss = SpreadsheetApp.create('Autoavaliação PPGAU 2026 – Banco de dados');
  const part = ss.getSheets()[0].setName('Participantes');
  part.appendRow(['Nome completo', 'E-mail', 'Lattes', 'Questionário', 'Data']);
  part.setFrozenRows(1); part.getRange(1, 1, 1, 5).setFontWeight('bold');
  DADOS.forEach(p => {
    const sh = ss.insertSheet('Respostas ' + p.id);
    const cab = ['Data'].concat(colunas(p).map(c => c.rot));
    sh.getRange(1, 1, 1, cab.length).setValues([cab]).setFontWeight('bold').setWrap(true);
    sh.setFrozenRows(1);
  });
  const senha = gerarSenha();
  PROPS.setProperties({ PLANILHA: ss.getId(), SENHA: senha });
  Logger.log('Instalado. Planilha (banco de dados): ' + ss.getUrl());
  Logger.log('SENHA DO PAINEL: ' + senha + '   (anote; para trocar, execute novaSenha)');
  Logger.log('Agora faça Implantar > Nova implantação > App da Web.');
}

function novaSenha() {
  const s = gerarSenha(); PROPS.setProperty('SENHA', s); Logger.log('Nova senha do painel: ' + s);
}
function gerarSenha() { return Utilities.getUuid().replace(/-/g, '').slice(0, 10); }

// Uma coluna por pergunta; perguntas em grade viram uma coluna por linha da grade.
function colunas(p) {
  const out = [];
  p.secoes.forEach(s => s.qs.forEach(q => {
    if (q.tipo === 'matrix') q.linhas.forEach((l, i) => out.push({ k: q.k, i: i, rot: q.k + ' ' + q.t + ' – ' + l, tipo: q.tipo }));
    else out.push({ k: q.k, rot: q.k + ' ' + q.t, tipo: q.tipo });
  }));
  return out;
}

function doGet(e) {
  const prm = (e && e.parameter) || {};
  if (prm.p === 'resumo') {
    return ContentService.createTextOutput(JSON.stringify(resumo())).setMimeType(ContentService.MimeType.JSON);
  }
  const boot = { modo: prm.p === 'admin' ? 'admin' : 'form', q: prm.q || '', dados: DADOS };
  const html = PAGINA.replace('/*BOOT*/', 'var BOOT = ' + JSON.stringify(boot).replace(/</g, '\\u003c') + ';');
  return HtmlService.createHtmlOutput(html)
    .setTitle(boot.modo === 'admin' ? 'Painel da coordenação · Autoavaliação PPGAU 2026' : 'Autoavaliação PPGAU/UNIVAG 2026')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

// Envio a partir do portal (site público): POST com JSON em texto simples.
function doPost(e) {
  let out;
  try {
    const d = JSON.parse((e && e.postData && e.postData.contents) || '{}');
    if (d.acao === 'verificar') out = verificar(d.email, d.pub);
    else if (d.acao === 'enviar') out = enviar(d);
    else if (d.acao === 'painel') out = painel(d.senha);
    else out = { erro: 'Ação inválida.' };
  } catch (err) { out = { erro: String(err && err.message || err) }; }
  return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON);
}

function planilha() {
  const id = PROPS.getProperty('PLANILHA');
  if (!id) throw new Error('O banco ainda não foi instalado. Execute a função instalar.');
  return SpreadsheetApp.openById(id);
}
function limpa(v, max) {
  let t = String(v == null ? '' : v).slice(0, max || 5000);
  if (/^[=+\-@]/.test(t)) t = "'" + t; // impede fórmulas na planilha
  return t;
}
function pubDe(id) { return DADOS.filter(p => p.id === id)[0]; }
function jaParticipou(sh, email, pub) {
  const n = sh.getLastRow(); if (n < 2) return false;
  return sh.getRange(2, 2, n - 1, 3).getValues().some(r => String(r[0]).toLowerCase() === email && r[2] === pub);
}

function verificar(email, pub) {
  email = String(email || '').trim().toLowerCase();
  return { ja: jaParticipou(planilha().getSheetByName('Participantes'), email, pub) };
}

function enviar(d) {
  const p = pubDe(d && d.pub);
  const email = String(d.email || '').trim().toLowerCase();
  const nome = String(d.nome || '').trim();
  if (!p) throw new Error('Questionário inválido.');
  if (!nome || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) throw new Error('Nome e e-mail são obrigatórios.');
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const ss = planilha(), part = ss.getSheetByName('Participantes');
    if (jaParticipou(part, email, p.id)) return { ja: true };
    const hoje = Utilities.formatDate(new Date(), TZ, 'yyyy-MM-dd');
    const r = d.r || {};
    const linha = [hoje].concat(colunas(p).map(c => {
      let v = r[c.k];
      if (c.tipo === 'matrix') v = v && v[c.i];
      if (Array.isArray(v)) v = v.join('; ');
      return limpa(v);
    }));
    // Respostas: posição sorteada, para que a ordem não revele quem respondeu.
    const rs = ss.getSheetByName('Respostas ' + p.id);
    const nR = rs.getLastRow(), posR = 1 + Math.floor(Math.random() * nR);
    rs.insertRowAfter(posR); rs.getRange(posR + 1, 1, 1, linha.length).setValues([linha]);
    // Participantes: em ordem alfabética.
    const nP = part.getLastRow();
    const nomes = nP > 1 ? part.getRange(2, 1, nP - 1, 1).getValues().map(x => String(x[0])) : [];
    let pos = nomes.findIndex(x => x.localeCompare(nome, 'pt-BR') > 0); pos = pos < 0 ? nomes.length : pos;
    part.insertRowAfter(pos + 1);
    part.getRange(pos + 2, 1, 1, 5).setValues([[limpa(nome, 200), limpa(email, 200), limpa(d.lattes, 300), p.id, hoje]]);
    return { ok: true };
  } finally { lock.releaseLock(); }
}

function autorizado(senha) {
  const dono = Session.getEffectiveUser().getEmail(), quem = Session.getActiveUser().getEmail();
  if (quem && dono && quem === dono) return true;
  const s = PROPS.getProperty('SENHA');
  return !!s && String(senha || '') === s;
}

function painel(senha) {
  if (!autorizado(senha)) { Utilities.sleep(800); return { ok: false }; }
  const ss = planilha(), part = ss.getSheetByName('Participantes'), n = part.getLastRow();
  const lista = n > 1 ? part.getRange(2, 1, n - 1, 5).getDisplayValues().map(r => ({ nome: r[0], email: r[1], lattes: r[2], pub: r[3], data: r[4] })) : [];
  const cont = {}; let total = 0;
  DADOS.forEach(p => { const sh = ss.getSheetByName('Respostas ' + p.id); const c = sh ? Math.max(0, sh.getLastRow() - 1) : 0; cont[p.id] = c; total += c; });
  const dono = Session.getEffectiveUser().getEmail() === Session.getActiveUser().getEmail();
  return { ok: true, part: lista, esperados: ESPERADOS, cont: cont, total: total, planilha: dono ? ss.getUrl() : '' };
}

// Resultados agregados para o portal (?p=resumo). Só perguntas fechadas e só
// para questionários com pelo menos 5 respostas, para proteger grupos pequenos.
function resumo() {
  // Enquanto a coleta está aberta, o resumo público traz só os totais (para não influenciar quem ainda vai responder).
  const fechado = PROPS.getProperty('RESULTADOS') !== 'abertos';
  const ss = planilha(), out = { atualizado: new Date().toISOString(), fechado: fechado, publicos: {} };
  DADOS.forEach(p => {
    const sh = ss.getSheetByName('Respostas ' + p.id), n = sh ? sh.getLastRow() - 1 : 0;
    const res = { n: Math.max(0, n), perguntas: {} };
    if (n >= 5 && !fechado) {
      const cols = colunas(p), vals = sh.getRange(2, 2, n, cols.length).getValues();
      cols.forEach((c, j) => {
        if (c.tipo === 'open' || c.tipo === 'text' || c.tipo === 'date') return;
        const chave = c.tipo === 'matrix' ? c.k + '|' + c.i : c.k, f = {};
        vals.forEach(r => { const v = String(r[j]); if (!v) return; (c.tipo === 'multi' ? v.split('; ') : [v]).forEach(x => { x = /^Outro: /.test(x) ? 'Outro' : x; f[x] = (f[x] || 0) + 1; }); });
        res.perguntas[chave] = f;
      });
    }
    out.publicos[p.id] = res;
  });
  return out;
}

// Divulgação dos gráficos no site: execute "abrirResultados" ao encerrar a coleta
// (ou "fecharResultados" para ocultar de novo). Até lá, o site mostra só a participação.
function abrirResultados() { PROPS.setProperty('RESULTADOS', 'abertos'); Logger.log('Resultados abertos no site.'); }
function fecharResultados() { PROPS.deleteProperty('RESULTADOS'); Logger.log('Resultados ocultos no site.'); }

// Para escolher a senha do painel: troque ESCREVA_AQUI pela senha (mantenha as aspas),
// escolha "minhaSenha" na lista ao lado de Depuração e clique em Executar.
function minhaSenha() {
  const senha = 'ESCREVA_AQUI';
  if (!senha || senha === 'ESCREVA_AQUI') throw new Error('Escreva a senha entre as aspas, no lugar de ESCREVA_AQUI.');
  PROPS.setProperty('SENHA', senha);
  Logger.log('Senha do painel alterada.');
}
